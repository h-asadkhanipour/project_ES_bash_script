#!/bin/bash

# This script is only for Exome Sequencing analysis of paired-end short read 
# sequencing data of Illumina sequencers.

###############################################################################
# set sample directory 
# set ngs data directory
# set number of threads
###############################################################################

sample_dir="/mnt/hgfs/sharefolder/test"
ngsdb="/mnt/hgfs/sharefolder/ngsdb"
threads=8

reference_GRCh37=""
reference_GRCh38=""
reference_hg19=""
reference_hg38="$ngsdb/gatk-hg38/Homo_sapiens_assembly38.fasta"

bqsr_1000g=""
bqsr_omni="$ngsdb/gatk-hg38/1000G_omni2.5.hg38.vcf.gz"
bqsr_hapmap="$ngsdb/gatk-hg38/hapmap_3.3.hg38.vcf.gz"
bqsr_dbsnp="$ngsdb/gatk-hg38/Homo_sapiens_assembly38.dbsnp138.vcf"
bqsr_known_indel="$ngsdb/gatk-hg38/Homo_sapiens_assembly38.known_indels.vcf.gz"
bqsr_mills_indel="$ngsdb/gatk-hg38/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz"

vqsr_hapmap="$ngsdb/gatk-hg38/hapmap_3.3.hg38.vcf.gz"
vqsr_omni="$ngsdb/gatk-hg38/1000G_omni2.5.hg38.vcf.gz"
vqsr_1000g=""
vqsr_dbsnp="$ngsdb/gatk-hg38/Homo_sapiens_assembly38.dbsnp138.vcf"
vqsr_mills_indel="$ngsdb/gatk-hg38/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz"
vqsr_axion="$ngsdb/gatk-hg38/Axiom_Exome_Plus.genotypes.all_populations.poly.hg38.vcf.gz"


###############################################################################
# Creating the FASTA sequence dictionary and index file 
###############################################################################

if [ -f "$ngsdb/gatk-hg38/Homo_sapiens_assembly38.dict" ]; then
	echo " Sequnce dictionary for gatk has been made already "
else
	gatk CreateSequenceDictionary -R $reference_hg38
fi


if [ -f "$reference_hg38.fai" ]; then
	echo " Index for samtools has been made already "
else
	samtools faidx $reference_hg38
fi


if [ -f "$reference_hg38.bwt" ]; then
	echo " Index for bwa has been made already "
else
	bwa index -a bwtsw $reference_hg38
fi


##############################################################################
# make directory in sample directory for better organization of files
##############################################################################

if [ -d "${sample_dir}/raw_data/" ] && [ -d "${sample_dir}/annotation_filtering/" ] && [ -d "${sample_dir}/fastq_after_QC/" ] && [ -d "${sample_dir}/alignment_postalignment/" ] && [ -d "${sample_dir}/raw_vcf/" ]; then
	echo " Sub directories has been made already "
else
	mkdir ${sample_dir}/raw_data ${sample_dir}/annotation_filtering ${sample_dir}/fastq_after_QC ${sample_dir}/alignment_postalignment ${sample_dir}/raw_vcf
	echo " Sub directories has been made "
fi


##############################################################################
# check raw file format
##############################################################################

# Check if files are compressed 
if [ -f $(ls $sample_dir) ]
if [ -f "${sample_dir}/*.gz" ]; then
	echo " Raw fastq files are compressed "
	mv ${sample_dir}/*.gz ${sample_dir}/raw_data/
else
	echo " Start comperssing raw files for memory efficiency "
	pigz -p $threads ${sample_dir}/*.fastq
	mv ${sample_dir}/*.gz ${sample_dir}/raw_data/
fi

# Rename files to sample_R1 and sample_R2
if [ -f "${sample_dir}/raw_data/*R1*" ] && [ -f "${sample_dir}/raw_data/*R2*" ]; then
	mv ${sample_dir}/*R{1..2}* ${}/sample_R{1..2}.fastq.gz
elif [ -f "${sample_dir}/raw_data/*1.*.gz" ] && [ -f "${sample_dir}/raw_data/*2.*.gz" ] ; then
	mv ${sample_dir}/raw_data/*{1..2}.*.gz ${sample_dir}/raw_data/sample_R{1..2}.fastq.gz
else
	echo " Rename raw files manually to sample_R1.fasq.gz and sample_R2.fastq.gz "
fi

echo " fffuuuucccckkkk"
exit
###############################################################################
# fastq quality control 
###############################################################################

# quality control of raw fastq files
fastqc -t $threads ${sample_dir}/raw_data/*.gz

read -p " Check fastQC reports in ${sample_dir}/raw_data/\n\n Press y if QC is ok:\t" qc_is_ok

# simple fastp output // no trimming // removing low quality reads and reads with length below fastp defualt // v1
if []; then
	fastp -V -j ${sample_dir}/fastq_after_QC/report_v1.json -h ${sample_dir}/fastq_after_QC/report_v1.html -i ${sample_dir}/raw_data/*.gz -o ${sample_dir}/fastq_after_QC/read_1_v1.fastq.gz -I ${sample_dir}/raw_data/*.gz -O ${sample_dir}/fastq_after_QC/read_2_v1.fastq.gz 

	fastqc -t $threads  ${project}/fastq_after_QC/read_?_v1.*

# result --> it worked BUT not as much as I thought // error for Per tile sequence quality remained


# second version // triming and stricter quality check with fastp // v2

fastp -V --length_required 20 -f 15 -F 15 -j ${project}/fastq_after_QC/report_v2.json -h ${project}/fastq_after_QC/report_v2.html -i ${project}/raw_data/Get-01-619_S68_R1_001.fastq.gz -o ${project}/fastq_after_QC/read_1_v2.fastq.gz -I ${project}/raw_data/Get-01-619_S68_R2_001.fastq.gz -O ${project}/fastq_after_QC/read_2_v2.fastq.gz

fastqc -t 8  ${project}/fastq_after_QC/read_?_v2.*

# result --> quality of fastq files is not perfect BUT I will continue with v2 version of fastp result

################################################################################################################################################
############################################## alignment and post alignment ####################################################################
################################################################################################################################################

bwa mem -t 8 -M $reference_hg38 ${project}/fastq_after_QC/read_1_v2.fastq.gz ${project}/fastq_after_QC/read_1_v2.fastq.gz > ${project}/alignment_postalignment/aligned.sam

# result --> successful // Real time: 3283.559 sec; CPU: 9527.232 sec

############################################# post alignment ####################################################################################

gatk SortSam -I ${project}/alignment_postalignment/aligned.sam -O ${project}/alignment_postalignment/after_sort.bam -SO coordinate

# result --> successful //  picard.sam.SortSam done. Elapsed time: 11.79 minutes

gatk AddOrReplaceReadGroups -I ${project}/alignment_postalignment/after_sort.bam -O ${project}/alignment_postalignment/after_rg.bam -ID HTYYCBBXX.1.CH_plate1_A01 -SM CH_plate1_A01 -LB Lib-1  -PU HTYYCBBXX.1.TCAATCCG+TTCGCAGT -PL ILLUMINA

# result --> successful // picard.sam.AddOrReplaceReadGroups done. Elapsed time: 2.35 minutes

gatk MarkDuplicates -I ${project}/alignment_postalignment/after_rg.bam -O ${project}/alignment_postalignment/after_md.bam -M ${project}/alignment_postalignment/report_md.text

# result --> successful // INFO	2025-06-14 00:06:45	MarkDuplicates	Marking 37602388 records as duplicates.
# INFO	2025-06-14 00:06:45	MarkDuplicates	Found 477798 optical duplicate clusters.
# INFO	2025-06-14 00:06:45	MarkDuplicates	Reads are assumed to be ordered by: coordinate
# picard.sam.markduplicates.MarkDuplicates done. Elapsed time: 5.53 minutes

# optional removing unnecessary data
# rm -f ${project}/alignment_postalignment/after_sort.bam ${project}/alignment_postalignment/after_rg.bam ${project}/alignment_postalignment/aligned.sam

gatk BuildBamIndex -I ${project}/alignment_postalignment/after_md.bam -O ${project}/alignment_postalignment/after_md.bai

# result --> successful // picard.sam.BuildBamIndex done. Elapsed time: 1.03 minutes

########################################## alignment quality control ###########################################################################


gatk CollectAlignmentSummaryMetrics -I ${project}/alignment_postalignment/after_md.bam -O ${project}/alignment_postalignment/report-casm.text -R $reference_hg38
ecode=$?
echo "CollectAlignmentSummaryMetrics exit code is:$ecode" >> ${project}/alignment_postalignment/log_report.txt

gatk CollectQualityYieldMetrics -I ${project}/alignment_postalignment/after_md.bam -O ${project}/alignment_postalignment/report-cqym.text -R $reference_hg38
ecode=$?
echo "CollectQualityYieldMetrics exit code is:$ecode" >> ${project}/alignment_postalignment/log_report.txt

gatk CollectBaseDistributionByCycle -I ${project}/alignment_postalignment/after_md.bam -O ${project}/alignment_postalignment/report-cbdbc.text -R $reference_hg38 -CHART ${project}/alignment_postalignment/report-cbdbc.pdf
ecode=$?
echo "CollectBaseDistributionByCycle exit code is:$ecode" >> ${project}/alignment_postalignment/log_report.txt

gatk CollectGcBiasMetrics -I ${project}/alignment_postalignment/after_md.bam -O ${project}/alignment_postalignment/report-cgcbm.text -R $reference_hg38 -CHART ${project}/alignment_postalignment/report-cgcbm.pdf -S ${project}/alignment_postalignment/report-cgcbm-s.text
ecode=$?
echo "CollectGcBiasMetrics exit code is:$ecode" >> ${project}/alignment_postalignment/log_report.txt

gatk CollectInsertSizeMetrics -I ${project}/alignment_postalignment/after_md.bam -O ${project}/alignment_postalignment/report-cism.text -R $reference_hg38 -H ${project}/alignment_postalignment/report-cism.pdf -M 0.05
ecode=$?
echo "CollectInsertSizeMetrics exit code is:$ecode" >> ${project}/alignment_postalignment/log_report.txt

gatk CollectOxoGMetrics -I ${project}/alignment_postalignment/after_md.bam -O ${project}/alignment_postalignment/report-cogm.text -R $reference_hg38 
ecode=$?
echo "CollectOxoGMetrics exit code is:$ecode" >> ${project}/alignment_postalignment/log_report.txt

gatk MeanQualityByCycle -I ${project}/alignment_postalignment/after_md.bam -O ${project}/alignment_postalignment/report-mqbc.text -R $reference_hg38 -CHART ${project}/alignment_postalignment/report-mqbc.pdf
ecode=$?
echo "MeanQualityByCycle exit code is:$ecode" >> ${project}/alignment_postalignment/log_report.txt

gatk CollectJumpingLibraryMetrics -I ${project}/alignment_postalignment/after_md.bam -O ${project}/alignment_postalignment/report-cjlm.text -R $reference_hg38
ecode=$?
echo "CollectJumpingLibraryMetrics exit code is:$ecode" >> ${project}/alignment_postalignment/log_report.txt

gatk CollectSequencingArtifactMetrics -I ${project}/alignment_postalignment/after_md.bam -O ${project}/alignment_postalignment/report-csam.text -R $reference_hg38
ecode=$?
echo "CollectSequencingArtifactMetrics exit code is:$ecode" >> ${project}/alignment_postalignment/log_report.txt


echo "all post alignment quality control is done"

# result --> successful

###############################################################################################################################################
########################################  BQSR // VQSR ########################################################################################
###############################################################################################################################################


gatk BaseRecalibrator -I ${project}/alignment_postalignment/after_md.bam -O ${project}/alignment_postalignment/bqsr_1.recall -R $reference_hg38 --known-sites $bqsr_omni --known-sites $bqsr_dbsnp --known-sites $bqsr_hapmap --known-sites $bqsr_known_indel --known-sites $bqsr_mills_indel
ecode=$?
echo "BaseRecalibrator exit code is:$ecode" >> ${project}/alignment_postalignment/log_report.txt

# result --> successful // org.broadinstitute.hellbender.tools.walkers.bqsr.BaseRecalibrator done. Elapsed time: 10.15 minutes

gatk ApplyBQSR -I ${project}/alignment_postalignment/after_md.bam -bqsr ${project}/alignment_postalignment/bqsr_1.recall -O ${project}/alignment_postalignment/after_bqsr.bam -R $reference_hg38 
ecode=$?
echo "ApplyBQSR exit code is:$ecode" >> ${project}/alignment_postalignment/log_report.txt

# result --> successful org.broadinstitute.hellbender.tools.walkers.bqsr.ApplyBQSR done. Elapsed time: 17.99 minutes

gatk BaseRecalibrator -I ${project}/alignment_postalignment/after_bqsr.bam -O ${project}/alignment_postalignment/bqsr_2.recall -R $reference_hg38 --known-sites $bqsr_omni --known-sites $bqsr_dbsnp --known-sites $bqsr_hapmap --known-sites $bqsr_known_indel --known-sites $bqsr_mills_indel
ecode=$?
echo "BaseRecalibrator2 exit code is:$ecode" >> ${project}/alignment_postalignment/log_report.txt

# result --> successful // org.broadinstitute.hellbender.tools.walkers.bqsr.BaseRecalibrator done. Elapsed time: 11.43 minutes

gatk AnalyzeCovariates -before ${project}/alignment_postalignment/bqsr_1.recall -after ${project}/alignment_postalignment/bqsr_2.recall -plots ${project}/alignment_postalignment/report-bqsr.pdf -csv ${project}/alignment_postalignment/report-bqsr.csv 
ecode=$?
echo "AnalyzeCovariates exit code is:$ecode" >> ${project}/alignment_postalignment/log_report.txt

echo "BQSR is done"

# result --> successful

gatk HaplotypeCaller -I ${project}/alignment_postalignment/after_bqsr.bam -O ${project}/raw_vcf/raw_vcf.vcf -R $reference_hg38

# result --> successful

# VQSR-SNP

gatk VariantRecalibrator -mode SNP -V ${project}/raw_vcf/raw_vcf.vcf -O ${project}/raw_vcf/vqsr-snp.vcf -R $reference_hg38 --tranches-file ${project}/raw_vcf/snp-tranch.tranches -tranche 100 -tranche 99.9 -tranche 99 -tranche 90 -an QD -an MQ -an MQRankSum -an ReadPosRankSum -an FS -an SOR --rscript-file ${project}/raw_vcf/report-vqsr-snp.R --resource:hapmap,truth=true,training=true,known=false,prior=15 $vqsr_hapmap --resource:omni,truth=true,training=true,known=false,prior=12 $vqsr_omni --resource:dbsnp,truth=false,training=false,known=true,prior=2 $vqsr_dbsnp

# result --> done with scale error

gatk ApplyVQSR -mode SNP -V ${project}/raw_vcf/raw_vcf.vcf --recal-file ${project}/raw_vcf/vqsr-snp.vcf --tranches-file ${project}/raw_vcf/snp-tranch.tranches -ts-filter-level 99 -O ${project}/raw_vcf/after-vqsr-snp.vcf 

# result --> org.broadinstitute.hellbender.tools.walkers.vqsr.ApplyVQSR done

# VQSR-INDEL

gatk VariantRecalibrator -mode INDEL -V ${project}/raw_vcf/raw_vcf.vcf -O ${project}/raw_vcf/vqsr-indel.vcf -R $reference_hg38 --tranches-file ${project}/raw_vcf/indel-tranch.tranches -tranche 100 -tranche 99.9 -tranche 99 -tranche 90 -an QD -an MQ -an MQRankSum -an ReadPosRankSum -an FS -an SOR --rscript-file ${project}/raw_vcf/report-vqsr-indel.R --resource:mills,truth=true,training=true,known=false,prior=12 $vqsr_mills_indel  --resource:dbsnp,truth=false,training=false,known=true,prior=2 $vqsr_dbsnp --resource:axion,truth=false,training=true,known=false,prior=10 $vqsr_axion

# result --> done

gatk ApplyVQSR -mode INDEL -V ${project}/raw_vcf/raw_vcf.vcf --recal-file ${project}/raw_vcf/vqsr-indel.vcf --tranches-file ${project}/raw_vcf/indel-tranch.tranches -ts-filter-level 99 -O ${project}/raw_vcf/after-vqsr-indel.vcf 


############################################################### variants check #################################################################

gatk CountVariants -V ${project}/raw_vcf/after-vqsr-snp.vcf 

# result -->

bcftools stats ${project}/raw_vcf/after-vqsr-snp.vcf  > ${project}/raw_vcf/report-bcftools-snp.text 

# result -->

# validatevariants only runs if something goes wrong it will show error, else it only runs
gatk ValidateVariants -V ${project}/raw_vcf/after-vqsr-snp.vcf -R $reference_hg38 --dbsnp $bqsr_dbsnp

# result --> done

###############################################################################################################################################
############################################################## annotation #####################################################################
###############################################################################################################################################

perl annovar/table_annovar.pl  ${project}/raw_vcf/after-vqsr-snp.vcf annovar/humandb/ -v --remove --buildver hg38 --outfile ${project}/annotation_filtering/after_anno.vcf --vcfinput --nastring . --protocol refGene,knownGene,ensGene,gnomad41_exome,clinvar_20240917,avsnp151,dbnsfp47a --operation gx,g,g,f,f,f,f -xref ~/annovar/example/gene_xref.txt



###############################################################################################################################################
############################################################## filtering ######################################################################
###############################################################################################################################################

cd ${project}/annotation_filtering

################################################# modifying annotated vcf of annovar ##########################################################

R

# required library

library("tidyr")

# loading data

vcf <- read.delim(file ="", header = T)

# seperate last column into 5 columns 

vcf <- vcf %>% 
  separate(Otherinfo13, into = c("genotype", "allele.depth", "depth", "genotype.quality", "PL"), sep = "[:]")
 
# select columns that you want
vcf <- vcf[,c("Chr",
              "Start",
              "End",
              "Ref",
              "Alt",
              "ExonicFunc.refGene",
              "AAChange.refGene",
              "Gene.refGene",
              "Gene.knownGene",
              "Gene.ensGene",
              "Func.refGene",
              "Func.knownGene",
              "Func.ensGene",
              "Xref.refGene",
              "gnomad41_exome_AF",
              "gnomad41_exome_AF_grpmax",
              "CLNDN",
              "CLNREVSTAT",
              "CLNSIG",
              "avsnp151",
              "REVEL_score",
              "VEST4_score",
              "BayesDel_noAF_score",
              "AlphaMissense_score",
              "CADD_phred",
              "Otherinfo10",
              "genotype",
              "allele.depth",
              "depth",
              "genotype.quality"
              )]

# save it
write.table(vcf,file = "modified-vcf",sep = "\t", quote = F, row.names = F)


############################################### filtering variants that didn't pass vqsr ######################################################

awk 'NR==1 || $26 == "PASS"'  FS='\t' OFS='\t' 

######################################## filtering variants that have population frequency more than 0.01 #####################################

awk 'NR==1 || $16 <= 0.01'  FS='\t' OFS='\t' 

######################################## filtering variants that have depth less than 7 ########################################################

awk 'NR==1 || $29 >= 7'  FS='\t' OFS='\t'

######################################## filtering variants that are benign ####################################################################

awk 'NR==1 ||!($0 ~ /intergenic/ || $0 ~ /intronic/ || $0 ~ /downstream/ || $0 ~ /upstream/ || $0 ~ /UTR3/ || $0 ~ /ncRNA_exonic/ || $0 ~ /UTR5/ || $0 ~ /Benign\/Likely_benign/ || $0 ~ /Likely_benign/ || $0 ~ /Benign/)' 

################################################## apply panel #################################################################################

grep -wf ${project}/panel/panel_v1 

grep stopgain 

grep frameshift

grep splicing

grep startloss



